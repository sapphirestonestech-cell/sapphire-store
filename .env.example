# Sapphire — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# ---------------------------------------------------------------- database
# MongoDB connection string (local or Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/sapphire

# ---------------------------------------------------------------- admin auth
# Secret used to sign the admin session cookie. Use a long random string.
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Credentials used once by `npm run seed` to create the first admin user.
# The password is hashed with bcrypt before it is stored; never re-used at runtime.
SEED_ADMIN_EMAIL=admin@sapphire.test
SEED_ADMIN_PASSWORD=choose-a-strong-password

# ---------------------------------------------------------------- customer auth
# Secret used by Auth.js to sign customer session tokens.
#   npx auth secret   (or: openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string

# Public origin of the site — used in password-reset email links and in
# payment gateway return URLs. BACHS rejects localhost in success_url, so
# local BACHS testing needs a public origin here (e.g. an ngrok tunnel URL).
# In production set this to the real domain, e.g. https://sapphire.example.com
APP_URL=http://localhost:3000

# Google OAuth (optional). Create at https://console.cloud.google.com/
# APIs & Services → Credentials → OAuth client ID (Web application).
# Redirect URI for local dev: http://localhost:3000/api/auth/callback/google
# Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- email
# Gmail SMTP — free transactional email via smtp.gmail.com.
# Create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the Google account). Leave both empty to
# log emails to the server console in development instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Display name for the From header; defaults to the Gmail address when empty.
EMAIL_FROM=

# ---------------------------------------------------------------- images
# Cloudinary — used for signed, direct-to-Cloudinary product image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------- payments
# One secret key per gateway and mode. The admin picks test or live in
# Settings → Payment gateways; keys are never entered in the UI. Never commit
# live keys. Paystack: sk_test_... / sk_live_...
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_LIVE_SECRET_KEY=
# While production still holds the old single-key variables, live mode falls
# back to PAYSTACK_SECRET_KEY / BACHS_SECRET_KEY so a deploy cannot break live
# payments. Set the *_LIVE_SECRET_KEY variables to retire the fallback.
# BACHS: one secret key per mode (no separate API key) — Authorization: Bearer.
# sk_sandbox_... talks to https://sandbox-api.bachs.io; sk_live_... to
# https://api.bachs.io. A key with the wrong prefix for its variable is
# ignored, so that mode stays unavailable until it is corrected.
BACHS_TEST_SECRET_KEY=
BACHS_LIVE_SECRET_KEY=
# Per-endpoint webhook signing secret from the BACHS Developer Portal
# (whsec_...). Signature verification fails closed until this is set.
BACHS_WEBHOOK_SECRET=
